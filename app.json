{
  "expo": {
    "name": "Epic Trip",
    "slug": "epic-trip",
    "version": "1.8.11",
    "orientation": "portrait",
    "icon": "./assets/img/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/img/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.myepictrip",
      "buildNumber": "575",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/adaptive-icon.png",
        "backgroundColor": "#C2185B"
      },
      "package": "app.myepictrip",
      "versionCode": 575,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/img/favicon.png"
    },
    "owner": "novigo-it",
    "extra": {
      "eas": {
        "projectId": "db969fca-1beb-44ee-9f79-97519a82855c"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": {
            "ios": {
              "purpose": "Allow Epic Trip to use your location."
            }
          },
          "locationAlwaysPermission": {
            "ios": {
              "purpose": "Allow Epic Trip to use your location."
            }
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Epic Trip to use your photo library."
        }
      ]
    ]
  }
}