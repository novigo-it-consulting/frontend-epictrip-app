{
  "expo": {
    "name": "Epic Trip",
    "slug": "epic-trip",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/img/icon.png",
    "userInterfaceStyle": "#FFF",
    "splash": {
      "image": "./assets/img/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.myepictrip",
      "buildNumber": "30"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/adaptive-icon.png",
        "backgroundColor": "#C2185B",
        "translucent": false
      },
      "package": "app.myepictrip",
      "versionCode": "30"
    },
    "web": {
      "favicon": "./assets/img/favicon.png"
    },
    "owner": "novigo-it",
    "extra": {
      "eas": {
        "projectId": "db969fca-1beb-44ee-9f79-97519a82855c"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow EpicTrip to use your location."
        }
      ]
    ]
  }
}
