{
  "expo": {
    "name": "Epic Trip",
    "slug": "epic-trip",
    "version": "1.5.2",
    "orientation": "portrait",
    "icon": "./assets/img/icon.png",
    "userInterfaceStyle": "#FFF",
    "splash": {
      "image": "./assets/img/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.myepictrip",
      "buildNumber": "421",
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "usesCleartextTraffic": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/adaptive-icon.png",
        "backgroundColor": "#C2185B",
        "translucent": false
      },
      "package": "app.myepictrip",
      "versionCode": 76,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/img/favicon.png"
    },
    "owner": "novigo-it",
    "extra": {
      "eas": {
        "projectId": "db969fca-1beb-44ee-9f79-97519a82855c"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": {
            "ios": {
              "purpose": "Allow Epic Trip to use your location."
            }
          },
          "locationAlwaysPermission": {
            "ios": {
              "purpose": "Allow Epic Trip to use your location."
            }
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Epic Trip to use your photo library."
        }
      ]
    ],
    "server": {
      "androidScheme": "https",
      "allowNavigation": [
        "qa-backend.myepictrip.app"
      ]
    }
  }
}
